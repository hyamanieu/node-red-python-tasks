        "functionBody": "current = threading.current_thread()\nmsg = {\"PID:\": os.getpid(),\n\"Parent PID\": os.getppid(),\n\"Process name\": multiprocessing.current_process().name,\n\"Parent process\": multiprocessing.parent_process().name if multiprocessing.parent_process() else None,\n\"Thread name\": current.name,\n\"Thread ID\": current.ident,\n\"Is main thread\": current is threading.main_thread()\n}\nreturn msg",
