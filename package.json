{
  "name": "node-red-python-tasks",
  "version": "0.1.0",
  "description": "Node-RED nodes for calling Python functions from your flows",
  "keywords": [
    "node-red",
    "python",
    "pixi"
  ],
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyamanieu/node-red-python-tasks.git"
  },
  "bugs": {
    "url": "https://github.com/hyamanieu/node-red-python-tasks/issues"
  },
  "homepage": "https://github.com/hyamanieu/node-red-python-tasks#readme",
  "main": "nodes/index.js",
  "scripts": {
    "preinstall": "curl -fsSL https://pixi.sh/install.sh | PIXI_HOME=/usr/src/node-red/.pixi PIXI_VERSION=v0.81.0 PIXI_NO_PATH_UPDATE=1 sh",
    "test": "mocha test/**/*_spec.js"
  },
  "node-red": {
    "nodes": {
      "python-env": "nodes/python-env.js",
      "python-function": "nodes/python-function.js",
      "python-run": "nodes/python-run.js"
    }
  },
  "dependencies": {
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "chai": "^4.3.7",
    "mocha": "^10.2.0",
    "node-red-node-test-helper": "^0.3.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
